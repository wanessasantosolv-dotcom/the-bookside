# Supabase → Project Settings → API
# (a "anon"/"publishable" key é pública; NUNCA coloque a service_role aqui)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# (ou, com o nome novo do Supabase: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...)

# Opcional: chave do Google Books (Google Cloud → APIs → Books API → Credenciais).
# Fica só no servidor (sem NEXT_PUBLIC): buscas mais rápidas, com cache, sem bloqueio.
GOOGLE_BOOKS_API_KEY=
