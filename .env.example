# Supabase → Project Settings → API
# (a "anon"/"publishable" key é pública; NUNCA coloque a service_role aqui)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# (ou, com o nome novo do Supabase: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...)

# Opcional: chave do Google Books (Google Cloud → APIs → Books API → Credenciais).
# Fica só no servidor (sem NEXT_PUBLIC): buscas mais rápidas, com cache, sem bloqueio.
GOOGLE_BOOKS_API_KEY=

# IA (completar livro e sugerir citações). Só no servidor: NUNCA com NEXT_PUBLIC.
# Use UMA das duas. Com as duas, o app usa o Gemini.
# Gemini (cota grátis diária): crie em aistudio.google.com → Get API key.
GEMINI_API_KEY=
# opcional: nome do modelo do Gemini, se o padrão sair de linha
GEMINI_MODEL=
# Claude (pago por uso):
# Crie em console.anthropic.com → API Keys e coloque na Vercel (Settings → Environment Variables).
ANTHROPIC_API_KEY=
